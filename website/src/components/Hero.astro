---
import heroImage from '../assets/screenshots/hero-dark.png';
---

<section class="w-hero">
  <div class="w-hero-bg"></div>

  <h1 class="w-hero-title hero-animate" data-delay="0">
    The video player<br>macOS deserves.
  </h1>

  <p class="w-hero-subtitle hero-animate" data-delay="1">
    Play anything. Beautifully.
  </p>

  <div class="w-hero-cta-group hero-animate" data-delay="2">
    <a href="#" class="w-btn-primary" data-download>
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.89C10.1 6.87 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
      Download for macOS
    </a>
    <span class="w-hero-meta">macOS 13+<span>&middot;</span>Apple Silicon &amp; Intel<span>&middot;</span>Free during early access</span>
  </div>

  <div class="w-hero-screenshot hero-animate" data-delay="3">
    <div class="w-hero-screenshot-inner">
      <img src={heroImage.src} alt="Lumiere playing a video with subtitles and playback controls" width={heroImage.width} height={heroImage.height} loading="eager" decoding="async" />
    </div>
  </div>
</section>

<style>
  .w-hero {
    position: relative;
    padding: 120px 40px 80px;
    text-align: center;
    overflow: hidden;
    background: var(--w-bg);
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .w-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--w-gradient-hero);
    pointer-events: none;
  }

  .w-hero-title {
    font-family: var(--w-font-display);
    font-size: 72px;
    font-weight: 400;
    font-style: italic;
    line-height: 1.05;
    letter-spacing: -.03em;
    color: var(--w-t1);
    margin-bottom: 20px;
    max-width: 800px;
    position: relative;
  }

  .w-hero-subtitle {
    font-size: 20px;
    font-weight: 400;
    color: var(--w-t2);
    margin-bottom: 48px;
    letter-spacing: -.01em;
    position: relative;
  }

  .w-hero-cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 64px;
    position: relative;
  }

  .w-hero-meta {
    font-size: 13px;
    color: var(--w-t3);
    letter-spacing: -.01em;
  }

  .w-hero-meta span {
    margin: 0 6px;
    opacity: .4;
  }

  /* Screenshot */
  .w-hero-screenshot {
    position: relative;
    max-width: 1060px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .w-hero-screenshot::before {
    content: '';
    position: absolute;
    top: -40px;
    left: 10%;
    right: 10%;
    bottom: -40px;
    background: radial-gradient(ellipse, rgba(255, 255, 255, .03) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: -1;
  }

  .w-hero-screenshot-inner {
    position: relative;
    border-radius: var(--w-radius-xl);
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: var(--w-shadow-screenshot), var(--w-shadow-glow);
    border: 1px solid rgba(255, 255, 255, .08);
  }

  .w-hero-screenshot-inner img {
    display: block;
    width: 100%;
    height: auto;
  }

  .w-hero-screenshot-placeholder {
    color: var(--w-t4);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    padding: 40px;
  }

  .w-hero-screenshot-placeholder .label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--w-t3);
    margin-bottom: 8px;
    font-family: var(--w-font-mono);
  }

  .w-hero-screenshot-placeholder .note {
    margin-top: 8px;
    color: var(--w-t4);
    font-size: 12px;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .w-hero {
      padding: 100px 32px 60px;
    }

    .w-hero-title {
      font-size: 56px;
    }

    .w-hero-subtitle {
      font-size: 18px;
    }
  }

  @media (max-width: 767px) {
    .w-hero {
      padding: 100px 20px 48px;
      min-height: auto;
    }

    .w-hero-title {
      font-size: 40px;
    }

    .w-hero-subtitle {
      font-size: 16px;
      margin-bottom: 32px;
    }

    .w-hero-cta-group {
      margin-bottom: 48px;
    }

    .w-hero-meta {
      font-size: 12px;
    }

    .w-hero-screenshot {
      padding: 0;
    }
  }
</style>
