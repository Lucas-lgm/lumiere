---
---

<footer class="w-footer">
  <div class="w-footer-left">&copy; 2026 Lumiere</div>
  <div class="w-footer-links">
    <a class="w-footer-link" href="/privacy">Privacy</a>
    <a class="w-footer-link" href="/changelog">Changelog</a>
    <a class="w-footer-link" href="https://twitter.com/lumiere_app" target="_blank" rel="noopener">Twitter</a>
  </div>
</footer>

<style>
  .w-footer {
    padding: 32px 40px;
    border-top: 1px solid var(--w-border);
    background: var(--w-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .w-footer-left {
    font-size: 13px;
    color: var(--w-t4);
    font-weight: 500;
  }

  .w-footer-links {
    display: flex;
    gap: 24px;
  }

  .w-footer-link {
    font-size: 13px;
    color: var(--w-t3);
    text-decoration: none;
    transition: color var(--w-duration-fast);
  }

  .w-footer-link:hover {
    color: var(--w-t1);
  }

  @media (max-width: 767px) {
    .w-footer {
      flex-direction: column;
      gap: 16px;
      text-align: center;
      padding: 32px 20px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .w-footer {
      padding: 32px 32px;
    }
  }
</style>
