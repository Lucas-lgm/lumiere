<section class="w-bottom-cta">
  <div class="w-bottom-cta-bg"></div>
  <h2 class="w-bottom-cta-title scroll-reveal">Ready to play?</h2>
  <div class="scroll-reveal">
    <a href="#" class="w-btn-primary" data-download>
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.89C10.1 6.87 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
      Download for macOS
    </a>
  </div>
</section>

<style>
  .w-bottom-cta {
    padding: 160px 40px;
    background: var(--w-bg);
    text-align: center;
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--w-border);
  }

  .w-bottom-cta-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at 50% 60%, rgba(255, 255, 255, .03) 0%, transparent 50%);
    pointer-events: none;
  }

  .w-bottom-cta-title {
    font-family: var(--w-font-display);
    font-size: 56px;
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    color: var(--w-t1);
    margin-bottom: 40px;
    position: relative;
    letter-spacing: -.02em;
  }

  @media (max-width: 1023px) {
    .w-bottom-cta {
      padding: 100px 32px;
    }

    .w-bottom-cta-title {
      font-size: 44px;
    }
  }

  @media (max-width: 767px) {
    .w-bottom-cta {
      padding: 80px 20px;
    }

    .w-bottom-cta-title {
      font-size: 36px;
      margin-bottom: 32px;
    }
  }
</style>
