---
interface Props {
  activePage?: 'features' | 'changelog' | 'privacy';
}

const { activePage } = Astro.props;
const featuresHref = '/#features';
---

<nav class="w-nav hero-animate" data-delay="4" id="main-nav">
  <a href="/" class="w-nav-logo">
    <div class="w-nav-logo-mark">L</div>
    <div class="w-nav-logo-text">Lumiere</div>
  </a>

  <div class="w-nav-right">
    <a href="#" class="w-nav-cta" data-download>Download</a>
    <button class="w-nav-hamburger" id="nav-hamburger" aria-label="Open menu">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="w-nav-links" id="nav-links">
    <a href={featuresHref} class:list={["w-nav-link", { active: activePage === 'features' }]}>Features</a>
    <a href="/changelog" class:list={["w-nav-link", { active: activePage === 'changelog' }]}>Changelog</a>
    <a href="/privacy" class:list={["w-nav-link", { active: activePage === 'privacy' }]}>Privacy</a>
    <a href="#" class="w-nav-cta w-nav-cta-desktop" data-download>Download</a>
  </div>

  <div class="w-nav-overlay" id="nav-overlay">
    <a href={featuresHref} class="w-nav-overlay-link">Features</a>
    <a href="/changelog" class="w-nav-overlay-link">Changelog</a>
    <a href="/privacy" class="w-nav-overlay-link">Privacy</a>
    <a href="#" class="w-btn-primary" data-download style="margin-top:16px">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 21.99 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 21.99C7.79 22.03 6.8 20.68 5.96 19.47C4.25 16.97 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.89C10.1 6.87 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
      Download for macOS
    </a>
  </div>
</nav>

<style>
  .w-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: var(--w-nav-height);
    background: transparent;
    border-bottom: 1px solid var(--w-border);
    transition: background var(--w-duration-normal), backdrop-filter var(--w-duration-normal);
  }

  .w-nav.scrolled {
    background: var(--w-bg-overlay);
    backdrop-filter: blur(20px) saturate(1.2);
  }

  .w-nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    z-index: 1001;
  }

  .w-nav-logo-mark {
    width: 28px;
    height: 28px;
    background: #ffffff;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: #0a0a0a;
    font-family: var(--w-font-display);
    font-style: italic;
  }

  .w-nav-logo-text {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -.02em;
    color: var(--w-t1);
  }

  .w-nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .w-nav-link {
    font-size: 14px;
    font-weight: 400;
    color: var(--w-t3);
    text-decoration: none;
    transition: color var(--w-duration-fast);
  }

  .w-nav-link:hover {
    color: var(--w-t1);
  }

  .w-nav-link.active {
    color: var(--w-t1);
  }

  .w-nav-cta {
    font-size: 13px;
    font-weight: 600;
    padding: 8px 20px;
    border-radius: var(--w-radius-pill);
    background: var(--w-t1);
    color: var(--w-bg);
    border: none;
    cursor: pointer;
    transition: all var(--w-duration-fast);
    letter-spacing: -.01em;
    text-decoration: none;
  }

  .w-nav-cta:hover {
    background: var(--w-t2);
    transform: translateY(-1px);
  }

  /* Nav right group (CTA + hamburger) */
  .w-nav-right {
    display: none;
    align-items: center;
    gap: 12px;
    z-index: 1001;
  }

  .w-nav-right .w-nav-cta {
    font-size: 12px;
    padding: 6px 14px;
  }

  /* Hide the desktop CTA inside nav-links on desktop (shown via .w-nav-links .w-nav-cta-desktop) */

  /* Hamburger */
  .w-nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1001;
    padding: 4px;
  }

  .w-nav-hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--w-t1);
    transition: all var(--w-duration-normal) var(--w-ease-out);
    transform-origin: center;
  }

  .w-nav-hamburger.open span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .w-nav-hamburger.open span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile overlay */
  .w-nav-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--w-bg);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--w-duration-normal) var(--w-ease-out);
  }

  .w-nav-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .w-nav-overlay-link {
    font-size: 24px;
    font-weight: 500;
    color: var(--w-t2);
    text-decoration: none;
    transition: color var(--w-duration-fast);
  }

  .w-nav-overlay-link:hover {
    color: var(--w-t1);
  }

  @media (max-width: 767px) {
    .w-nav {
      padding: 0 20px;
    }

    .w-nav-links {
      display: none;
    }

    .w-nav-right {
      display: flex;
    }

    .w-nav-hamburger {
      display: flex;
    }

    .w-nav-overlay {
      display: flex;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .w-nav {
      padding: 0 32px;
    }
  }
</style>

<script>
  // Nav scroll behavior
  const nav = document.getElementById('main-nav');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 20) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Mobile hamburger
  const hamburger = document.getElementById('nav-hamburger');
  const overlay = document.getElementById('nav-overlay');
  if (hamburger && overlay) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('open');
      overlay.classList.toggle('open');
      document.body.style.overflow = overlay.classList.contains('open') ? 'hidden' : '';
    });

    // Close overlay on link click
    overlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      });
    });
  }
</script>
